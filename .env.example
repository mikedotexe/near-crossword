NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_LEGACY_CONTRACT_ID=crossword.puzzle.near
NEXT_PUBLIC_LEGACY_NEAR_NETWORK=mainnet
NEXT_PUBLIC_LEGACY_APP_URL=
# Local-only identity used only when NODE_ENV is not production and
# V2_FUNDING_MODE=mock. Never configure this on a live deployment.
NEXT_PUBLIC_V2_DEMO_USER_ID=creator@example.test

# V2 escrow configuration. Pin these per deployment; never infer a token
# contract from display metadata.
V2_NEAR_NETWORK=testnet
V2_CONTRACT_ID=crossword-v2.your-account.testnet
V2_USDC_ASSET_ID=nep141:usdc.testnet
V2_USDC_CONTRACT_ID=usdc.testnet
# Browser wallet calls are fail-closed unless these public pins exactly match
# the server values above.
NEXT_PUBLIC_V2_CONTRACT_ID=crossword-v2.your-account.testnet
NEXT_PUBLIC_V2_USDC_CONTRACT_ID=usdc.testnet
V2_FUNDING_MODE=mock
V2_NEAR_RPC_URL=https://test.rpc.fastnear.com
V2_CHAIN_BROADCAST_ENABLED=false
V2_OPERATOR_ACCOUNT_ID=operator.your-account.testnet
V2_OPERATOR_PRIVATE_KEY=
V2_WORKER_POLL_INTERVAL_MS=5000
# Name only the client-IP header that a trusted ingress overwrites. Forwarded
# headers are ignored by default to prevent trivial rate-limit spoofing.
V2_TRUSTED_CLIENT_IP_HEADER=

# AI generation is a server-only, x402-metered v2 service.
NEAR_AI_API_KEY=
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# Candidate model; confirm clue quality and account access before enabling x402.
# GLM 5.1 uses its documented non-thinking mode; other models keep provider defaults.
V2_AI_MODEL=zai-org/GLM-5.1-FP8

# Read-only Base accounting. No RPC, deployment or finality policy is assumed.
BASE_INDEXER_ENABLED=false
BASE_CHAIN_ID=
BASE_RPC_URL=
BASE_ESCROW_ADDRESS=
BASE_ESCROW_RUNTIME_CODE_HASH=
BASE_ESCROW_DEPLOYMENT_BLOCK=
BASE_ESCROW_DEPLOYMENT_BLOCK_HASH=
BASE_MAX_FINALIZED_LAG_SECONDS=

# Private Base authoring/review only. Does not enable funding, signing, or payouts.
# Requires database sessions and same-origin mutations pinned by NEXTAUTH_URL.
BASE_REVIEW_ENABLED=false
# Public funded catalog and reviewed publication. Synthetic practice/demo routes
# stay public without this gate and never issue, fund, or claim rewards.
BASE_PUBLICATION_ENABLED=false
BASE_UI_PREVIEW_ENABLED=false
# CDP User Wallet and counterfactual verification are separate opt-in gates.
BASE_ACCOUNT_ENABLED=false
# Public CDP project identifier used by the browser SDK. This is not an API key.
NEXT_PUBLIC_CDP_PROJECT_ID=
# Server validates CDP access tokens before creating a short Crossword session.
# Use a Secret API Key from the same CDP project; never expose it to the browser.
CDP_PARTICIPANT_AUTH_ENABLED=false
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Keep SDK telemetry off for private authentication operations.
DISABLE_CDP_ERROR_REPORTING=true
DISABLE_CDP_USAGE_TRACKING=true
BASE_COUNTERFACTUAL_ENABLED=false
BASE_ACCOUNT_FACTORY_ADDRESS=
BASE_ACCOUNT_FACTORY_CODE_HASH=
BASE_ACCOUNT_IMPLEMENTATION_CODE_HASH=
# Keep off until a claim-only proxy and provider budget/allowlist are reviewed.
# Public HTTPS proxy URL only. Never put the keyed CDP paymaster URL here.
# Proxy is locally implemented for reviewed EntryPoint 0.6 Base Sepolia only.
# CDP User Wallet acceptance remains required; do not enable from examples.
BASE_SPONSORED_GAS_ENABLED=false
BASE_SPONSORED_CLAIM_PROXY_URL=
BASE_PAYMASTER_PROXY_ENABLED=false
BASE_PAYMASTER_POLICY_REVIEWED=false
# Dedicated CDP Base Sepolia endpoint, server-only, NEVER NEXT_PUBLIC_.
# Managed CDP sponsorship uses account billing, not an ETH-funded seed wallet.
# Keep deployer keys in an external encrypted keystore, never in this web env.
BASE_PAYMASTER_UPSTREAM_URL=
BASE_PAYMASTER_ADDRESS=
BASE_PAYMASTER_CODE_HASH=
BASE_ENTRYPOINT_CODE_HASH=
BASE_ACCOUNT_PROXY_CODE_HASH=
# Explicit bounded gas policy; no spending defaults. Values are integer gas/wei.
# Total allowance is a lifetime ceiling per deployment, not a daily reset.
BASE_GAS_MAX_CALL=
BASE_GAS_MAX_VERIFICATION=
BASE_GAS_MAX_PRE_VERIFICATION=
BASE_GAS_MAX_FEE_WEI=
BASE_GAS_MAX_OPERATION_WEI=
BASE_GAS_TOTAL_BUDGET_WEI=
BASE_GAS_MAX_OPERATIONS_PER_ACCOUNT=
# Participant API and signing have separate gates. Neither sends transactions.
BASE_PARTICIPANT_ENABLED=false
BASE_CLAIM_ISSUANCE_ENABLED=false
# Dedicated eligibility signer only, never a sponsor, wallet, staking or treasury key.
BASE_ELIGIBILITY_PRIVATE_KEY=

# Postgres
DATABASE_URL=postgresql://near_crossword:near_crossword_dev@localhost:5432/near_crossword

# Resend email (optional — skip emails if missing)
RESEND_API_KEY=re_...

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_GOOGLE_CLIENT_ID=
NEXTAUTH_GOOGLE_CLIENT_SECRET=
NEXTAUTH_EMAIL_FROM=NEAR Crossword <noreply@crossword.xyz>

# --- Tempo MPP × Intents ---
# Disabled until the upgraded server-side adapter is explicitly configured.
# No MPP package or payment key is shipped to the browser.
MPP_INTENTS_ENABLED=false

# --- NEAR Intents / 1Click ---
ONECLICK_JWT=

# --- x402 v2 ---
X402_ENABLED=false
X402_NETWORK=near:testnet
X402_PAY_TO=operator.your-account.testnet
X402_ASSET=usdc.testnet
X402_AI_PRICE_ATOMIC=100000
X402_FACILITATOR_URL=
X402_FACILITATOR_BEARER_TOKEN=

# Secrets and private keys must remain server-only. Do not add NEXT_PUBLIC_ to
# V2_OPERATOR_PRIVATE_KEY or provider API keys. The retired legacy worker and
# its shared full-access NEAR key are intentionally not configurable here.

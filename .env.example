NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_CONTRACT_NAME=your-crossword-account.testnet

NEXT_PUBLIC_NEAR_AI_ENABLED=false
NEXT_PUBLIC_MARKET_NEAR_AI_URL=https://market.near.ai
NEXT_PUBLIC_NEAR_AI_AGENT_ID=

# --- Agent Worker (worker/) ---
# market.near.ai
MARKET_API_KEY=your-market-near-ai-bearer-token
MARKET_URL=https://market.near.ai

# Claude API (used by both worker/ and pages/api/generate-clues.js)
ANTHROPIC_API_KEY=sk-ant-...

# NEAR blockchain
NEAR_ACCOUNT_ID=crossword.puzzle.near
NEAR_PRIVATE_KEY=ed25519:your-private-key-here
NEAR_NETWORK=testnet

# Worker settings
POLL_INTERVAL_MS=60000
MATCH_TAGS=crossword,puzzle,education,marketing

# Crossword viewer URL
CROSSWORD_URL=https://crossword.xyz

# Postgres
DATABASE_URL=postgresql://user:password@localhost:5432/near_crossword

# Resend email (optional — skip emails if missing)
RESEND_API_KEY=re_...

# --- NextAuth ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_GOOGLE_CLIENT_ID=
NEXTAUTH_GOOGLE_CLIENT_SECRET=
NEXTAUTH_EMAIL_FROM=NEAR Crossword <noreply@crossword.xyz>

# Twitter/X API (for auto-tweeting new puzzles)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# --- Tempo MPP (Multi-Currency Payments) ---
MPP_RECIPIENT=0x5d5fc6d8abce5a9a21891914bd869848305e390e
MPP_SECRET_KEY=generate-with-openssl-rand-hex-32
MPP_CURRENCY=0x20c000000000000000000000b9537d11c60e8b50
MPP_REALM=crossword.xyz
# Set to "true" to use Tempo testnet (Moderato) instead of mainnet
MPP_TESTNET=false
# Client-side testnet flag (must be NEXT_PUBLIC_ for browser access)
NEXT_PUBLIC_MPP_TESTNET=false
